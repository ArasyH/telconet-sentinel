# ── TelcoNet-Sentinel · Streamlit Secrets ─────────────────────────────────────
#
# Cara pakai di Streamlit Cloud:
#   1. Buka app di Streamlit Cloud → Settings → Secrets
#   2. Copy-paste isi file ini (tanpa baris komentar) ke kolom secrets
#   3. Isi value sesuai API key yang dimiliki
#
# Cara pakai lokal (tanpa .env):
#   1. Salin file ini ke .streamlit/secrets.toml
#   2. Isi value-nya
#   File secrets.toml sudah ada di .gitignore — aman, tidak ter-commit.
# ──────────────────────────────────────────────────────────────────────────────

# Pilih provider: "groq" | "openrouter" | "fake"
LLM_MODE = "openrouter"

# ── Groq (aktif jika LLM_MODE = "groq") ──────────────────────────────────────
GROQ_API_KEY = ""
GROQ_MODEL = "qwen/qwen3.8-27b"

# ── OpenRouter (aktif jika LLM_MODE = "openrouter") ──────────────────────────
OPENROUTER_API_KEY = ""
OPENROUTER_MODEL = "meta-llama/llama-3.3-70b-instruct"
