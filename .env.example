# ── LLM Provider ─────────────────────────────────────────────────────────────
# Pilih salah satu: groq | openrouter | fake
LLM_MODE=groq

# ── Groq (aktif jika LLM_MODE=groq) ──────────────────────────────────────────
# Model yang tersedia & support JSON mode (per Nov 2026):
#   qwen/qwen3.8-27b     — default, ctx=131k, JSON mode ✓
#   openai/gpt-oss-120b  — ctx=131k, tanpa JSON mode
#   openai/gpt-oss-20b   — ctx=131k, tanpa JSON mode
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ── OpenRouter (aktif jika LLM_MODE=openrouter) ───────────────────────────────
# Model yang direkomendasikan (semua support JSON mode, harga per 1M token):
#
# Budget (< $1/1M out):
#   mistralai/mistral-small-3.2-24b-instruct  $0.075/$0.20  ctx=256k
#   anthropic/claude-haiku-5.5                $0.10/$0.50   ctx=1M
#   qwen/qwen3-32b                            $0.08/$0.28   ctx=131k
#   openai/gpt-4.1-nano                       $0.10/$0.40   ctx=1M
#
# Mid-tier ($1-$3/1M out):
#   meta-llama/llama-3.3-70b-instruct         $0.20/$0.52   ctx=131k  ← default
#   meta-llama/llama-4-maverick               $0.19/$0.65   ctx=524k
#   google/gemini-2.5-flash                   $0.30/$2.50   ctx=1M
#   openai/gpt-4o-mini                        $0.15/$0.60   ctx=128k
#   deepseek/deepseek-chat                    $0.26/$1.03   ctx=163k
#
# Premium (> $3/1M out):
#   anthropic/claude-haiku-4.5               $1.00/$5.00   ctx=200k
#   anthropic/claude-sonnet-4.6              $3.00/$15.00  ctx=1M
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # tidak perlu diubah
